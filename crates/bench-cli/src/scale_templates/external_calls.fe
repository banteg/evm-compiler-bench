use std::evm::{Call, Ctx}

msg ExternalCallsMsg {
    #[selector = sol("ping(uint256)")]
    Ping { x: u256 } -> u256,
    #[selector = sol("callMany()")]
    CallMany -> u256,
}

pub contract {{CONTRACT_NAME}} uses (ctx: Ctx, call: mut Call) {
    recv ExternalCallsMsg {
        Ping { x } -> u256 { x }

        CallMany -> u256 uses (ctx, mut call) {
            let me = ctx.address()
            var total: u256 = 0
            for i in 0..{{N}} {
                total += me.static(ExternalCallsMsg::Ping { x: i as u256 })
            }
            total
        }
    }
}
