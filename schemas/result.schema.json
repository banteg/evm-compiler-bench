{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVM Compiler Bench result row",
  "type": "object",
  "required": [
    "status",
    "benchmark_id",
    "implementation_id",
    "profile_id",
    "suite",
    "family",
    "parameter_name",
    "parameter_value",
    "generated",
    "provenance",
    "language",
    "compiler",
    "cache",
    "source_path",
    "source_hash",
    "compile",
    "bytecode",
    "gas",
    "correctness"
  ],
  "properties": {
    "status": { "enum": ["ok", "compile_error"] },
    "benchmark_id": { "type": "string" },
    "implementation_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "suite": { "enum": ["fixed", "scale", "real_derived"] },
    "family": { "type": ["string", "null"] },
    "parameter_name": { "type": ["string", "null"] },
    "parameter_value": { "type": ["integer", "null"], "minimum": 1 },
    "generated": {
      "type": "object",
      "required": ["generator_version", "scenario_path", "scenario_hash"],
      "properties": {
        "generator_version": { "type": ["string", "null"] },
        "scenario_path": { "type": ["string", "null"] },
        "scenario_hash": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "required": [
        "upstream_project",
        "repository_url",
        "source_commit",
        "source_path",
        "source_reference_path",
        "source_language",
        "source_compiler",
        "source_profiles",
        "source_contract",
        "source_blob",
        "upstream_license",
        "checked_at",
        "model_kind",
        "comparison_lane",
        "implementation_lane",
        "source_lane",
        "counterpart_lane",
        "production_equivalence",
        "api_compatibility",
        "storage_layout_compatibility",
        "external_token_semantics",
        "source_derivation",
        "port_language",
        "port_version",
        "equivalence_scope",
        "scenario_coverage",
        "mock_assumptions",
        "included_features",
        "excluded_features"
      ],
      "properties": {
        "upstream_project": { "type": "string" },
        "repository_url": { "type": "string" },
        "source_commit": { "type": "string" },
        "source_path": { "type": "string" },
        "source_reference_path": { "type": "string" },
        "source_language": { "enum": ["solidity", "vyper"] },
        "source_compiler": { "type": "string" },
        "source_profiles": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "source_contract": { "type": "string" },
        "source_blob": { "type": ["string", "null"] },
        "upstream_license": { "type": "string" },
        "checked_at": { "type": "string" },
        "model_kind": { "type": "string" },
        "comparison_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "implementation_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "source_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "counterpart_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "production_equivalence": { "type": "boolean" },
        "api_compatibility": { "type": "string" },
        "storage_layout_compatibility": { "type": "boolean" },
        "external_token_semantics": { "type": "string" },
        "source_derivation": { "type": "string" },
        "port_language": { "enum": ["solidity", "vyper"] },
        "port_version": { "type": "string" },
        "equivalence_scope": { "type": "array", "items": { "type": "string" } },
        "scenario_coverage": { "type": "array", "items": { "type": "string" } },
        "mock_assumptions": { "type": "array", "items": { "type": "string" } },
        "included_features": { "type": "array", "items": { "type": "string" } },
        "excluded_features": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": {
            "required": ["production_equivalence"],
            "properties": {
              "production_equivalence": { "const": true }
            }
          },
          "then": {
            "properties": {
              "excluded_features": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "excluded_features": { "minItems": 1 }
            }
          }
        },
        {
          "not": {
            "required": ["comparison_lane"],
            "properties": {
              "comparison_lane": { "const": "fixture_scoped_port" }
            }
          }
        },
        {
          "not": {
            "required": ["source_lane"],
            "properties": {
              "source_lane": {
                "enum": [
                  "production_conformance",
                  "diagnostic_layout_matched",
                  "fixture_scoped_port"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["comparison_lane"],
            "properties": {
              "comparison_lane": { "const": "production_conformance" }
            }
          },
          "then": {
            "properties": {
              "source_lane": { "const": "latest_syntax_original" }
            }
          }
        },
        {
          "if": {
            "required": ["comparison_lane"],
            "properties": {
              "comparison_lane": { "const": "latest_idiomatic" }
            }
          },
          "then": {
            "properties": {
              "source_lane": { "const": "latest_idiomatic" }
            }
          }
        },
        {
          "if": {
            "required": ["source_lane", "source_language"],
            "properties": {
              "source_lane": { "const": "latest_syntax_original" },
              "source_language": { "const": "solidity" }
            }
          },
          "then": {
            "properties": {
              "source_profiles": {
                "items": { "pattern": "^solc-latest" }
              }
            }
          }
        },
        {
          "if": {
            "required": ["source_lane", "source_language"],
            "properties": {
              "source_lane": { "const": "latest_syntax_original" },
              "source_language": { "const": "vyper" }
            }
          },
          "then": {
            "properties": {
              "source_profiles": {
                "items": { "pattern": "^vyper-latest" }
              }
            }
          }
        }
      ]
    },
    "language": { "enum": ["solidity", "vyper"] },
    "compiler": {
      "type": "object",
      "required": ["name", "version", "settings", "metadata"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "metadata": { "type": "object" },
        "settings": {
          "type": "object",
          "required": ["evmVersion", "metadataMode", "sourceVariant"],
          "properties": {
            "evmVersion": { "type": "string" },
            "metadataMode": { "enum": ["on", "off"] },
            "sourceVariant": { "type": "string" }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "required": ["compile", "gas"],
      "properties": {
        "compile": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["hit", "miss", "stale", "refreshed", "disabled"]
            }
          }
        },
        "gas": {
          "type": ["object", "null"],
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["hit", "miss", "stale", "refreshed", "disabled"]
            }
          }
        }
      }
    },
    "source_path": { "type": "string" },
    "source_hash": { "type": "string" },
    "compile": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "error"] },
        "wall_ms_samples": { "type": "array", "items": { "type": "number" } },
        "cpu_ms_samples": { "type": "array", "items": { "type": "number" } },
        "peak_rss_kib": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "bytecode": { "type": ["object", "null"] },
    "gas": {
      "type": ["object", "null"],
      "required": [
        "scenario",
        "evm_fork",
        "state_access_profile",
        "metadata_mode",
        "internal_create_gas",
        "harness_call_gas",
        "intrinsic_gas",
        "calldata_gas",
        "harness_estimated_tx_gas",
        "total_tx_gas",
        "expected_success",
        "call_succeeded",
        "scenario_status_ok",
        "measurement_scope"
      ],
      "properties": {
        "scenario": { "type": "string" },
        "evm_fork": { "type": "string" },
        "state_access_profile": { "enum": ["cold", "warm", "mixed"] },
        "metadata_mode": { "enum": ["on", "off"] },
        "internal_create_gas": { "type": "integer", "minimum": 0 },
        "harness_call_gas": { "type": "integer", "minimum": 0 },
        "intrinsic_gas": { "type": "integer", "minimum": 0 },
        "calldata_gas": { "type": "integer", "minimum": 0 },
        "harness_estimated_tx_gas": { "type": "integer", "minimum": 0 },
        "total_tx_gas": { "type": "null" },
        "expected_success": { "type": "boolean" },
        "call_succeeded": { "type": "boolean" },
        "scenario_status_ok": { "type": "boolean" },
        "measurement_scope": { "const": "foundry_internal_call_harness" }
      }
    },
    "correctness": {
      "type": "object",
      "required": [
        "scenario_status_check",
        "golden_behavior_check",
        "baseline_differential_check",
        "profile_behavior_check",
        "observer_check",
        "return_data_check",
        "log_check",
        "randomized_differential_check",
        "property_tests",
        "failure_artifacts",
        "scenario_status_ok"
      ],
      "properties": {
        "scenario_status_check": { "enum": ["pass", "fail", "not_applicable", "not_run", "baseline_only"] },
        "golden_behavior_check": { "enum": ["pass", "fail", "not_applicable", "not_run"] },
        "baseline_differential_check": { "enum": ["pass", "fail", "not_applicable", "not_run", "baseline_only"] },
        "profile_behavior_check": { "enum": ["pass", "fail", "not_applicable", "not_run"] },
        "observer_check": { "enum": ["pass", "fail", "not_applicable", "not_run", "baseline_only"] },
        "return_data_check": { "enum": ["pass", "fail", "not_applicable", "not_run", "baseline_only"] },
        "log_check": { "enum": ["pass", "fail", "not_applicable", "not_run", "baseline_only"] },
        "randomized_differential_check": { "enum": ["pass", "fail", "not_applicable"] },
        "property_tests": { "enum": ["pass", "fail", "not_applicable"] },
        "properties": { "type": "array", "items": { "type": "string" } },
        "failure_artifacts": { "type": "array", "items": { "type": "string" } },
        "scenario_status_ok": { "type": "boolean" }
      }
    }
  }
}
