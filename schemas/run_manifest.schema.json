{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVM Compiler Bench run manifest",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "evm_version",
    "toolchains",
    "profiles",
    "scale_generator",
    "real_derived",
    "environment",
    "artifacts",
    "compile_failures",
    "gas_records"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "evm_version": { "type": "string" },
    "toolchains": { "type": "array", "items": { "type": "object" } },
    "profiles": { "type": "array", "items": { "type": "object" } },
    "scale_generator": {
      "type": "object",
      "required": ["version", "config_hash", "parameter_name", "values", "benchmarks"],
      "properties": {
        "version": { "type": "string" },
        "config_hash": { "type": "string" },
        "parameter_name": { "type": "string" },
        "values": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "benchmark_id",
              "family",
              "parameter_name",
              "parameter_value",
              "contract_name",
              "solidity_path",
              "solidity_hash",
              "vyper_path",
              "vyper_hash",
              "spec_path",
              "spec_hash",
              "scenario_path",
              "scenario_hash"
            ],
            "properties": {
              "benchmark_id": { "type": "string" },
              "family": { "type": "string" },
              "parameter_name": { "type": "string" },
              "parameter_value": { "type": "integer", "minimum": 1 },
              "contract_name": { "type": "string" },
              "solidity_path": { "type": "string" },
              "solidity_hash": { "type": "string" },
              "vyper_path": { "type": "string" },
              "vyper_hash": { "type": "string" },
              "spec_path": { "type": "string" },
              "spec_hash": { "type": "string" },
              "scenario_path": { "type": "string" },
              "scenario_hash": { "type": "string" }
            }
          }
        }
      }
    },
    "real_derived": {
      "type": "object",
      "required": ["benchmarks"],
      "properties": {
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "benchmark_id",
              "upstream_project",
              "repository_url",
              "source_commit",
              "source_path",
              "source_reference_path",
              "source_language",
              "source_compiler",
              "source_profiles",
              "source_contract",
              "source_blob",
              "upstream_license",
              "checked_at",
              "model_kind",
              "comparison_lane",
              "source_lane",
              "counterpart_lane",
              "production_equivalence",
              "api_compatibility",
              "storage_layout_compatibility",
              "external_token_semantics",
              "source_derivation",
              "equivalence_scope",
              "scenario_coverage",
              "mock_assumptions",
              "included_features",
              "excluded_features",
              "source_variants"
            ],
            "properties": {
              "benchmark_id": { "type": "string" },
              "upstream_project": { "type": "string" },
              "repository_url": { "type": "string" },
              "source_commit": { "type": "string" },
              "source_path": { "type": "string" },
              "source_reference_path": { "type": "string" },
              "source_language": { "enum": ["solidity", "vyper"] },
              "source_compiler": { "type": "string" },
              "source_profiles": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "source_contract": { "type": "string" },
              "source_blob": { "type": ["string", "null"] },
              "upstream_license": { "type": "string" },
              "checked_at": { "type": "string" },
              "model_kind": { "type": "string" },
              "comparison_lane": {
                "enum": [
                  "upstream_exact_historical",
                  "latest_syntax_original",
                  "latest_idiomatic",
                  "production_conformance",
                  "diagnostic_layout_matched",
                  "fixture_scoped_port"
                ]
              },
              "source_lane": {
                "enum": [
                  "upstream_exact_historical",
                  "latest_syntax_original",
                  "latest_idiomatic",
                  "production_conformance",
                  "diagnostic_layout_matched",
                  "fixture_scoped_port"
                ]
              },
              "counterpart_lane": {
                "enum": [
                  "upstream_exact_historical",
                  "latest_syntax_original",
                  "latest_idiomatic",
                  "production_conformance",
                  "diagnostic_layout_matched",
                  "fixture_scoped_port"
                ]
              },
              "production_equivalence": { "type": "boolean" },
              "api_compatibility": { "type": "string" },
              "storage_layout_compatibility": { "type": "boolean" },
              "external_token_semantics": { "type": "string" },
              "source_derivation": { "type": "string" },
              "equivalence_scope": { "type": "array", "items": { "type": "string" } },
              "scenario_coverage": { "type": "array", "items": { "type": "string" } },
              "mock_assumptions": { "type": "array", "items": { "type": "string" } },
              "included_features": { "type": "array", "items": { "type": "string" } },
              "excluded_features": { "type": "array", "items": { "type": "string" } },
              "source_variants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "language",
                    "implementation_id",
                    "profile_id",
                    "source_variant",
                    "source_path",
                    "source_hash",
                    "compile_status"
                  ],
                  "properties": {
                    "language": { "enum": ["solidity", "vyper"] },
                    "implementation_id": { "type": "string" },
                    "profile_id": { "type": "string" },
                    "source_variant": { "type": "string" },
                    "source_path": { "type": "string" },
                    "source_hash": { "type": "string" },
                    "compile_status": { "enum": ["ok", "compile_error"] }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["production_equivalence"],
                  "properties": {
                    "production_equivalence": { "const": true }
                  }
                },
                "then": {
                  "properties": {
                    "excluded_features": { "maxItems": 0 }
                  }
                },
                "else": {
                  "properties": {
                    "excluded_features": { "minItems": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "family", "command_line", "git", "tools", "host"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "family": { "type": "string" },
        "command_line": { "type": "array", "items": { "type": "string" } },
        "git": { "type": "object" },
        "tools": { "type": "object" },
        "host": { "type": "object" }
      }
    },
    "artifacts": { "type": "integer", "minimum": 0 },
    "compile_failures": { "type": "integer", "minimum": 0 },
    "gas_records": { "type": "integer", "minimum": 0 }
  }
}
