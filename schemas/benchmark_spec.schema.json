{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVM Compiler Bench benchmark spec",
  "type": "object",
  "required": ["id", "title", "abi", "scenarios", "implementations"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "abi": { "type": "array", "items": { "type": "string" } },
    "semantics": { "type": "array", "items": { "type": "string" } },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "call"],
        "properties": {
          "name": { "type": "string" },
          "call": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "scale": {
      "type": "object",
      "required": ["family", "parameter_name", "parameter_value"],
      "properties": {
        "family": { "type": "string" },
        "parameter_name": { "type": "string" },
        "parameter_value": { "type": "integer", "minimum": 1 }
      }
    },
    "real_derived": {
      "type": "object",
      "required": [
        "suite",
        "model_kind",
        "comparison_lane",
        "source_lane",
        "counterpart_lane",
        "upstream_project",
        "repository_url",
        "source_commit",
        "source_path",
        "source_language",
        "source_compiler",
        "source_profiles",
        "source_contract",
        "source_blob",
        "upstream_license",
        "checked_at",
        "production_equivalence",
        "api_compatibility",
        "storage_layout_compatibility",
        "external_token_semantics",
        "source_derivation",
        "equivalence_scope",
        "scenario_coverage",
        "mock_assumptions",
        "included_features",
        "excluded_features"
      ],
      "properties": {
        "suite": { "const": "real_derived" },
        "model_kind": { "type": "string" },
        "comparison_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "source_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "counterpart_lane": {
          "enum": [
            "upstream_exact_historical",
            "latest_syntax_original",
            "latest_idiomatic",
            "production_conformance",
            "diagnostic_layout_matched",
            "fixture_scoped_port"
          ]
        },
        "upstream_project": { "type": "string" },
        "repository_url": { "type": "string" },
        "source_commit": { "type": "string" },
        "source_path": { "type": "string" },
        "source_language": { "enum": ["solidity", "vyper"] },
        "source_compiler": { "type": "string" },
        "source_profiles": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "source_contract": { "type": "string" },
        "source_blob": { "type": "string" },
        "upstream_license": { "type": "string" },
        "checked_at": { "type": "string" },
        "production_equivalence": { "type": "boolean" },
        "api_compatibility": { "type": "string" },
        "storage_layout_compatibility": { "type": "boolean" },
        "external_token_semantics": { "type": "string" },
        "source_derivation": { "type": "string" },
        "equivalence_scope": { "type": "array", "items": { "type": "string" } },
        "scenario_coverage": { "type": "array", "items": { "type": "string" } },
        "mock_assumptions": { "type": "array", "items": { "type": "string" } },
        "included_features": { "type": "array", "items": { "type": "string" } },
        "excluded_features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementations": {
      "type": "object",
      "required": ["solidity", "vyper"],
      "properties": {
        "solidity": { "type": "string" },
        "vyper": { "type": "string" }
      }
    }
  }
}
