use std::evm::{Ctx, Log, StorageMap}
use std::evm::crypto
use std::abi::Bytes32

msg Create2Msg {
    #[selector = sol("saltValue(bytes32)")]
    SaltValue { salt: Bytes32 } -> u256,
    #[selector = sol("initCodeHash(uint256)")]
    InitCodeHash { value: u256 } -> Bytes32,
    #[selector = sol("computeAddress(bytes32,uint256)")]
    ComputeAddress { salt: Bytes32, value: u256 } -> Address,
    #[selector = sol("record(bytes32,uint256)")]
    Record { salt: Bytes32, value: u256 } -> u256,
}

#[event]
struct Recorded {
    #[indexed]
    salt: Bytes32,
    predicted: Address,
    value: u256,
}

struct Create2Store { salt_value: StorageMap<u256, u256> }

fn init_code_hash(value: u256) -> u256 {
    crypto::keccak_words([value])
}

fn compute_address(self_addr: Address, salt: u256, value: u256) -> Address {
    crypto::create2_address(deployer: self_addr, salt, init_code_hash: init_code_hash(value))
}

pub contract Create2AddressHashing uses (ctx: Ctx, log: mut Log) {
    mut store: Create2Store,

    recv Create2Msg {
        SaltValue { salt } -> u256 uses store {
            store.salt_value.get(key: salt.val)
        }

        InitCodeHash { value } -> Bytes32 {
            Bytes32 { val: init_code_hash(value) }
        }

        ComputeAddress { salt, value } -> Address
        uses ctx
        {
            compute_address(self_addr: ctx.address(), salt: salt.val, value)
        }

        Record { salt, value } -> u256 uses (mut store, ctx, mut log) {
            let predicted = compute_address(self_addr: ctx.address(), salt: salt.val, value)
            store.salt_value.set(key: salt.val, value: value)
            log.emit(
                Recorded { salt, predicted, value },
            )
            value
        }
    }
}
