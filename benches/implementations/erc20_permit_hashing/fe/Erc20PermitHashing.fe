use std::evm::{StorageMap, encode_abi_payload}
use std::evm::crypto
use std::abi::Bytes32

msg PermitMsg {
    #[selector = sol("nonces(address)")]
    Nonces { owner: Address } -> u256,
    #[selector = sol("hashPermit(address,address,uint256,uint256,uint256)")]
    HashPermit { owner: Address, spender: Address, value: u256, nonce: u256, deadline: u256 } -> Bytes32,
    #[selector = sol("useNonce(address)")]
    UseNonce { owner: Address } -> u256,
    #[selector = sol("hashCurrentPermit(address,address,uint256,uint256)")]
    HashCurrentPermit { owner: Address, spender: Address, value: u256, deadline: u256 } -> Bytes32,
}

struct PermitStore {
    nonces: StorageMap<Address, u256>,
}

fn hash_permit(owner: Address, spender: Address, value: u256, nonce: u256, deadline: u256) -> u256 {
    let (ptr, len) = encode_abi_payload((owner, spender, value, nonce, deadline))
    crypto::keccak256(ptr, len)
}

pub contract Erc20PermitHashing {
    mut store: PermitStore

    recv PermitMsg {
        Nonces { owner } -> u256 uses store { store.nonces.get(key: owner) }

        HashPermit { owner, spender, value, nonce, deadline } -> Bytes32 {
            Bytes32 { val: hash_permit(owner, spender, value, nonce, deadline) }
        }

        UseNonce { owner } -> u256 uses (mut store) {
            let current = store.nonces.get(key: owner)
            store.nonces.set(key: owner, value: current + 1)
            current
        }

        HashCurrentPermit { owner, spender, value, deadline } -> Bytes32 uses store {
            let nonce = store.nonces.get(key: owner)
            Bytes32 { val: hash_permit(owner, spender, value, nonce, deadline) }
        }
    }
}
