use std::evm::{Ctx, Log, StorageMap}
use std::evm::{crypto, clones}
use std::abi::Bytes32

msg Eip1167Msg {
    #[selector = sol("cloneValue(bytes32)")]
    CloneValue { salt: Bytes32 } -> u256,
    #[selector = sol("proxyCodeHash(address)")]
    ProxyCodeHash { implementation: Address } -> Bytes32,
    #[selector = sol("predictClone(address,bytes32)")]
    PredictClone { implementation: Address, salt: Bytes32 } -> Address,
    #[selector = sol("recordClone(address,bytes32,uint256)")]
    RecordClone { implementation: Address, salt: Bytes32, value: u256 } -> u256,
}

#[event]
struct Cloned {
    #[indexed]
    salt: Bytes32,
    predicted: Address,
    value: u256,
}

struct CloneStore { clone_value: StorageMap<u256, u256> }

fn proxy_code_hash(implementation: Address) -> u256 {
    crypto::keccak256(clones::clone_initcode(implementation))
}

fn predict_clone(self_addr: Address, implementation: Address, salt: u256) -> Address {
    crypto::create2_address(
        deployer: self_addr,
        salt,
        init_code_hash: proxy_code_hash(implementation),
    )
}

pub contract Eip1167CodehashBookkeeping uses (ctx: Ctx, log: mut Log) {
    mut store: CloneStore,

    recv Eip1167Msg {
        CloneValue { salt } -> u256 uses store {
            store.clone_value.get(key: salt.val)
        }

        ProxyCodeHash { implementation } -> Bytes32 {
            Bytes32 { val: proxy_code_hash(implementation) }
        }

        PredictClone { implementation, salt } -> Address
        uses ctx
        {
            predict_clone(self_addr: ctx.address(), implementation, salt: salt.val)
        }

        RecordClone { implementation, salt, value } -> u256
        uses (mut store, ctx, mut log)
        {
            let predicted = predict_clone(self_addr: ctx.address(), implementation, salt: salt.val)
            store.clone_value.set(key: salt.val, value: value)
            log.emit(
                Cloned { salt, predicted, value },
            )
            value
        }
    }
}
